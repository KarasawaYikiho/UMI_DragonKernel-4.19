+static bool add_type_legacy(struct policydb *db, const char *type_name, bool attr)
+{
+    struct flex_array *new_attr_map, *new_type_map, *new_name_map, *old;
+    struct type_datum *type;
+    char *key;
+    u32 value;
+    int i;
+
+    type = symtab_search(&db->p_types, type_name);
+    if (type)
+        return true;
+
+    value = ++db->p_types.nprim;
+    type = kzalloc(sizeof(*type), GFP_ATOMIC);
+    key = kstrdup(type_name, GFP_ATOMIC);
+    if (!type || !key)
+        return false;
+
+    type->primary = 1;
+    type->value = value;
+    type->attribute = attr;
+    if (symtab_insert(&db->p_types, key, type))
+        return false;
+
+    new_attr_map = flex_array_alloc(sizeof(struct ebitmap), value, GFP_ATOMIC | __GFP_ZERO);
+    new_type_map = flex_array_alloc(sizeof(struct type_datum *), value, GFP_ATOMIC | __GFP_ZERO);
+    new_name_map = flex_array_alloc(sizeof(char *), value, GFP_ATOMIC | __GFP_ZERO);
+    if (!new_attr_map || !new_type_map || !new_name_map)
+        return false;
+    if (flex_array_prealloc(new_attr_map, 0, value, GFP_ATOMIC | __GFP_ZERO) ||
+        flex_array_prealloc(new_type_map, 0, value, GFP_ATOMIC | __GFP_ZERO) ||
+        flex_array_prealloc(new_name_map, 0, value, GFP_ATOMIC | __GFP_ZERO))
+        return false;
+
+    for (i = 0; i < value - 1; i++) {
+        void *elem = flex_array_get(db->type_attr_map_array, i);
+        void *ptr = flex_array_get_ptr(db->type_val_to_struct_array, i);
+        void *name = flex_array_get_ptr(db->sym_val_to_name[SYM_TYPES], i);
+
+        if (elem)
+            flex_array_put(new_attr_map, i, elem, GFP_ATOMIC | __GFP_ZERO);
+        if (ptr)
+            flex_array_put_ptr(new_type_map, i, ptr, GFP_ATOMIC | __GFP_ZERO);
+        if (name)
+            flex_array_put_ptr(new_name_map, i, name, GFP_ATOMIC | __GFP_ZERO);
+    }
+
+    old = db->type_attr_map_array;
+    db->type_attr_map_array = new_attr_map;
+    flex_array_free(old);
+    ebitmap_init(flex_array_get(db->type_attr_map_array, value - 1));
+    ebitmap_set_bit(flex_array_get(db->type_attr_map_array, value - 1), value - 1, 1);
+
+    old = db->type_val_to_struct_array;
+    db->type_val_to_struct_array = new_type_map;
+    flex_array_free(old);
+    flex_array_put_ptr(db->type_val_to_struct_array, value - 1, type, GFP_ATOMIC | __GFP_ZERO);
+
+    old = db->sym_val_to_name[SYM_TYPES];
+    db->sym_val_to_name[SYM_TYPES] = new_name_map;
+    flex_array_free(old);
+    flex_array_put_ptr(db->sym_val_to_name[SYM_TYPES], value - 1, key, GFP_ATOMIC | __GFP_ZERO);
+
+    for (i = 0; i < db->p_roles.nprim; i++)
+        ebitmap_set_bit(&db->role_val_to_struct[i]->types, value - 1, 1);
